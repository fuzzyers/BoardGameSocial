    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "vitest",
        "db:schema": "node scripts/runSchema.js",
        "db:init": "node -e \"require('dotenv').config(); const { query } = require('./db'); const fs = require('fs'); const sql = fs.readFileSync('./schema.sql','utf8'); query(sql).then(() => console.log('Schema applied')).catch(err => { console.error(err); process.exit(1); });\""
