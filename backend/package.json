    "dependencies": {
        "axios": "^1.19.0",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^16.4.1",
        "express": "^5.2.1",
        "fast-xml-parser": "^5.10.1",
        "he": "^1.2.0",
        "jsonwebtoken": "^9.0.3",
